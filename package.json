{
  "name": "sporky",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 nuxt dev --https --sslKey cert/localhost.pem --ssl-key cert/localhost-key.pem --host 127.0.0.1",
    "dev:http": "nuxt dev --port 3000 --host 127.0.0.1",
    "dev:https": "NODE_TLS_REJECT_UNAUTHORIZED=0 nuxt dev --https --sslKey cert/localhost.pem --ssl-key cert/localhost-key.pem --port 3000 --host 127.0.0.1",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "generate-cert": "mkdir -p cert && openssl req -x509 -newkey rsa:4096 -keyout cert/localhost-key.pem -out cert/localhost.pem -days 365 -nodes -subj \"/C=US/ST=Dev/L=Dev/O=Dev/OU=Dev/CN=localhost\" -addext \"subjectAltName=DNS:localhost,IP:127.0.0.1\"",
    "lint": "prettier --write .",
    "lint:check": "prettier --check .",
    "format": "prettier --write .",
    "type-check": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons:subset": "node scripts/subset-icons.mjs",
    "icons:check": "node scripts/subset-icons.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@pinia/nuxt": "^1.0.3",
    "nuxt": "^4.6.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "devDependencies": {
    "@types/node": "^24",
    "prettier": "^3.6.2",
    "sass": "^1.108.2",
    "typescript": "~5.9.3",
    "vitest": "^4",
    "vue-tsc": "^3.3.14"
  }
}
